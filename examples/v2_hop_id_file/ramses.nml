! V2 fixed-grid DMO parent. The last scheduled output stops the run at a=1.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=0
ncontrol=1
nstepmax=10000
verbose=.false.
/

&OUTPUT_PARAMS
noutput=2
aout=0.01,1.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='v2.grafic_64'
/

&AMR_PARAMS
levelmin=6
levelmax=6
ngridmax=500000
npartmax=500000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/
