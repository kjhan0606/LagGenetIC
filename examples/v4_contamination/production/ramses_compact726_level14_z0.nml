! VoidSim V4 compact rank-726 level-14 DMO evolution.  Restart the verified
! post-step a=0.0221607 checkpoint and evolve to a=1.  The diffuse-gas
! void_refine floor is intentionally not enabled in this collisionless run.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=2
nremap=10
ncontrol=1
nstepmax=100000
use_fftw=.true.
verbose=.false.
/

&OUTPUT_PARAMS
noutput=5
aout=0.10,0.25,0.50,0.75,1.00
/

! This block is parsed even on restart.  Its fields are not used because the
! complete AMR and particle state is read from output_00002.
&INIT_PARAMS
/

&AMR_PARAMS
levelmin=9
levelmax=14
ngridmax=3000000
npartmax=24000000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=15*8.0
ivar_refine=0
/

&PHYSICS_PARAMS
omega_b=0.d0
/
