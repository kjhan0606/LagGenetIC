! VoidSim V4 compact rank-726 level-14 DMO one-step hand-off.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=10
ncontrol=1
nstepmax=1
use_fftw=.true.
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=0.02
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../genetic/v4_compact726_inverted.grafic_512'
initfile(2)='../genetic/v4_compact726_inverted.grafic_1024'
initfile(3)='../genetic/v4_compact726_inverted.grafic_2048'
initfile(4)='../genetic/v4_compact726_inverted.grafic_4096'
initfile(5)='../genetic/v4_compact726_inverted.grafic_8192'
initfile(6)='../genetic/v4_compact726_inverted.grafic_16384'
/

&AMR_PARAMS
levelmin=9
levelmax=14
ngridmax=1200000
npartmax=6000000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=15*8.0
ivar_refine=0
/

&PHYSICS_PARAMS
omega_b=0.d0
/
