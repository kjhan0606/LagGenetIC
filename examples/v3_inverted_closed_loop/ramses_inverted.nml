! V3 lagRamses ingestion of the sign-inverted two-level GRAFIC IC.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=0
ncontrol=1
nstepmax=1
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=0.02
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='v3_inverted.grafic_64'
initfile(2)='v3_inverted.grafic_128'
/

&AMR_PARAMS
levelmin=6
levelmax=7
ngridmax=1000000
npartmax=1000000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=0.0
ivar_refine=0
/
