! VoidSim V4 compact rank-726 level-14 DMO evolution.  Restart the verified
! a=0.02 hand-off and evolve to a=1.  The diffuse-gas void_refine floor is
! intentionally not enabled in this collisionless halo-yield calculation.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=1
nremap=10
ncontrol=1
nstepmax=100000
use_fftw=.true.
verbose=.false.
/

&OUTPUT_PARAMS
noutput=5
aout=0.10,0.25,0.50,0.75,1.00
/

&AMR_PARAMS
levelmin=9
levelmax=14
ngridmax=3000000
npartmax=24000000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=15*8.0
ivar_refine=0
/

&PHYSICS_PARAMS
omega_b=0.d0
/
