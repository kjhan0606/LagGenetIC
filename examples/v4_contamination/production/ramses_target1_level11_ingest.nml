! VoidSim V4 target-1 three-level DMO ingestion scale regression.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=10
ncontrol=1
nstepmax=1
use_fftw=.true.
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=0.02
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../inverted/v4_target1_inverted.grafic_512'
initfile(2)='../inverted/v4_target1_inverted.grafic_1024'
initfile(3)='../inverted/v4_target1_inverted.grafic_2048'
/

&AMR_PARAMS
levelmin=9
levelmax=11
ngridmax=1600000
npartmax=12000000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=11*8.0
ivar_refine=0
/

&PHYSICS_PARAMS
omega_b=0.d0
/
