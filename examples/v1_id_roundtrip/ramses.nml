! V1 128^3 single-level grafic round trip. RAMSES writes output_00001 at the
! initial epoch before taking the one allowed coarse step.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=0
ncontrol=1
nstepmax=1
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=0.02
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='v1.grafic_128'
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=2500000
npartmax=2500000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/

