! VoidSim V4 level-9 parent ingestion test.  Write the initial epoch and stop
! after one coarse step; the full z=0 parent evolution uses a separate nml.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=0
ncontrol=1
nstepmax=1
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=0.02
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../genetic/v4_parent.grafic_512'
/

&AMR_PARAMS
levelmin=9
levelmax=9
ngridmax=1500000
npartmax=10000000
nexpand=1
boxlen=1.0
/

&POISSON_PARAMS
epsilon=1.d-4
/
